      },
      {
        "kind": "message",
        "from": 3,
        "to": 2,
        "label": "return report widgets",
        "return": true
      },
      {
        "kind": "frame",
        "label": "alt [export requested]"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "data(scope, filters); build CSV or XLSX",
        "return": false
      },
      {
        "kind": "message",
        "from": 3,
        "to": 4,
        "label": "read additional export rows as required",
        "return": false
      },
      {
        "kind": "message",
        "from": 4,
        "to": 3,
        "label": "return export data",
        "return": true
      },
      {
        "kind": "message",
        "from": 3,
        "to": 2,
        "label": "return export content / workbook path",
        "return": true
      },
      {
        "kind": "message",
        "from": 2,
        "to": 1,
        "label": "download CSV / XLSX (private, no-store)",

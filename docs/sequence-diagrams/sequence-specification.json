[
  {
    "slug": "01-view-analytics",
    "title": "View analytics and export reports",
    "people": [
      "Administrator",
      "Web Application\n(Analytics UI)",
      "AnalyticsController",
      "Analytics Services\n(Report / Performance / Export)",
      "Application Database"
    ],

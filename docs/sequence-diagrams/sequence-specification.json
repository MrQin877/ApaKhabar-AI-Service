  {
    "slug": "06-comment-reply",
    "title": "Submit a comment or reply with moderation",
    "people": [
      "Reader\n(Guest / signed-in)",
      "Web Application\n(News UI)",
      "CommentController /\nGuestCommentIdentity",
      "InteractionService /\nCommentModeration",
      "Application Database",
      "Moderation API\n(OpenAI)"
    ],
    "events": [
      {
        "kind": "message",
        "from": 0,
        "to": 1,
        "label": "enter comment or reply",
        "return": false
      },
      {
        "kind": "message",
        "from": 1,
        "to": 2,
        "label": "POST /news/{id}/comment or /comments/{id}/replies",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 2,
        "label": "validate content; resolve published parent for replies",
        "return": false
      },
      {
        "kind": "frame",
        "label": "opt [guest reader]"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 2,
        "label": "validate challenge age 3s\u20132h, news ID and session",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 4,
        "label": "find/create guest identity; lock identity; read daily quota",
        "return": false
      },
      {
        "kind": "message",

      },
      {
        "kind": "message",
        "from": 1,
        "to": 0,
        "label": "save report file",
        "return": true
      },
      {
        "kind": "else",
        "label": "[view dashboard]"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "interactionTrend(); listing(); optional post inspection",

      },
      {
        "kind": "message",
        "from": 1,
        "to": 2,
        "label": "GET /admin/analytics",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 2,
        "label": "authorize administrator; validate dates, filters and range",
        "return": false
      },
      {
        "kind": "note",
        "label": "Authenticated, verified administrator required. Invalid filters stop the request; no report is returned."
      },
      {
        "kind": "message",
        "from": 2,
        "to": 4,
        "label": "read AnalyticsSetting::current() and layout",
        "return": false
      },
      {
        "kind": "message",
        "from": 4,
        "to": 2,
        "label": "return dashboard configuration",
        "return": true
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "build(widgets, from, to, source, platform)",
        "return": false
      },
      {
        "kind": "message",
        "from": 3,
        "to": 4,
        "label": "aggregate users, activity, news and broadcasts",
        "return": false
      },
      {
        "kind": "message",
        "from": 4,
        "to": 3,
        "label": "return aggregate rows",
        "return": true
      },
      {
        "kind": "message",
        "from": 3,
        "to": 4,
        "label": "read selected social connections and saved Meta snapshots",
        "return": false
      },
      {
        "kind": "message",
        "from": 4,
        "to": 3,
        "label": "return social metrics and sync status",

      },
      {
        "kind": "message",
        "from": 3,
        "to": 4,
        "label": "query likes, comments and post performance",
        "return": false
      },
      {
        "kind": "message",
        "from": 4,
        "to": 3,
        "label": "return rows and trends",
        "return": true
      },
      {
        "kind": "message",
        "from": 3,
        "to": 2,
        "label": "return performance data",
        "return": true
      },
      {
        "kind": "message",
        "from": 2,
        "to": 4,
        "label": "read categories and administrator connections",

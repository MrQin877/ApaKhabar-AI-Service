  {
    "slug": "02-sync-social-analytics",
    "title": "Synchronize social-media analytics",
    "people": [
      "Administrator",
      "Web Application\n(System)",
      "MetaAnalyticsController",
      "Queue Worker\nSyncMetaInsights / MetaInsights",
      "Application Database",
      "Meta Graph API"
    ],
    "events": [
      {
        "kind": "message",
        "from": 0,
        "to": 1,
        "label": "select accounts or request synchronization",
        "return": false
      },
      {
        "kind": "frame",
        "label": "alt [change selected accounts]"
      },
      {
        "kind": "message",
        "from": 1,
        "to": 2,
        "label": "PUT /admin/analytics/meta (connection_ids)",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 4,
        "label": "validate owned connections; one account per platform",
        "return": false
      },
      {
        "kind": "message",
        "from": 4,
        "to": 2,
        "label": "return validated connections",
        "return": true
      },
      {
        "kind": "message",
        "from": 2,
        "to": 4,
        "label": "transaction: update analytics_settings; insert setting change",
        "return": false
      },
      {
        "kind": "message",
        "from": 4,
        "to": 2,
        "label": "commit configuration",
        "return": true
      },
      {
        "kind": "else",
        "label": "[manual refresh]"
      },
      {
        "kind": "message",
        "from": 1,
        "to": 2,
        "label": "POST /admin/analytics/meta/sync",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 2,
        "label": "authorize administrator; apply route throttle",
        "return": false
      },
      {
        "kind": "end"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "dispatch SyncMetaInsights (unique job)",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 1,
        "label": "redirect back",
        "return": true
      },
      {
        "kind": "message",
        "from": 1,
        "to": 0,
        "label": "display current saved metrics",
        "return": true
      },
      {
        "kind": "message",
        "from": 3,
        "to": 4,
        "label": "read selected social_connections",
        "return": false
      },
      {
        "kind": "message",
        "from": 4,
        "to": 3,
        "label": "return configured connections",
        "return": true
      },
      {
        "kind": "frame",
        "label": "loop [each selected connection]"
      },
      {
        "kind": "frame",
        "label": "alt [connection is disconnected]"
      },
      {
        "kind": "message",
        "from": 3,
        "to": 4,
        "label": "set insights_status = disconnected",
        "return": false
      },
      {
        "kind": "else",
        "label": "[connection is usable]"
      },
      {
        "kind": "message",
        "from": 3,
        "to": 5,
        "label": "GET account insights (daily metrics; last 7 days)",
        "return": false
      },
      {
        "kind": "message",
        "from": 5,
        "to": 3,
        "label": "return metric series / provider error",
        "return": true
      },
      {
        "kind": "frame",
        "label": "alt [valid points and same account/token still selected]"
      },
      {
        "kind": "message",
        "from": 3,
        "to": 4,
        "label": "transaction: lock connection; recheck identity; upsert snapshots",
        "return": false
      },
      {
        "kind": "message",
        "from": 3,
        "to": 4,
        "label": "set insights_status = ready and insights_synced_at",
        "return": false
      },
      {
        "kind": "message",
        "from": 4,
        "to": 3,
        "label": "commit snapshots",
        "return": true
      },
      {
        "kind": "else",
        "label": "[no data / failure / changed connection]"
      },
      {
        "kind": "message",
        "from": 3,
        "to": 4,
        "label": "set no_data or unavailable; discard stale-account response",
        "return": false
      },
      {
        "kind": "end"
      },
      {
        "kind": "end"
      },
      {
        "kind": "end"
      },
      {
        "kind": "note",
        "label": "A later analytics request reads these snapshots. Queue timing depends on the configured driver; with a sync driver, dispatch runs inline. No automatic UI polling is implied."
      }
    ],
    "sources": [
      "app/Http/Controllers/Admin/MetaAnalyticsController.php",
      "app/Jobs/SyncMetaInsights.php",
      "app/Services/Analytics/MetaInsights.php:sync"
    ]
  },
  {
    "slug": "03-record-news-view",
    "title": "Record a news view",
    "people": [
      "Reader\n(Guest / signed-in)",
      "Web Application\n(News UI)",
      "EngagementController",
      "Application Database"
    ],
    "events": [
      {
        "kind": "message",
        "from": 0,
        "to": 1,
        "label": "open article",
        "return": false
      },
      {
        "kind": "message",
        "from": 1,
        "to": 2,
        "label": "GET /news/{id}/engagement",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "verify active news",
        "return": false
      },
      {
        "kind": "message",
        "from": 3,
        "to": 2,
        "label": "return news record",
        "return": true
      },
      {
        "kind": "message",
        "from": 2,
        "to": 2,
        "label": "create viewer key and session-bound encrypted token",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 1,
        "label": "return token; set news_visitor cookie",
        "return": true
      },
      {
        "kind": "note",
        "label": "The UI waits for the qualified reading interval while the document is visible. Server accepts token age 5 seconds to 2 hours."
      },
      {
        "kind": "message",
        "from": 1,
        "to": 2,
        "label": "POST /news/{id}/view (token)",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 2,
        "label": "decrypt; validate news ID, token age and session",
        "return": false
      },
      {
        "kind": "frame",
        "label": "alt [invalid token]"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 1,
        "label": "422: reject view request",
        "return": true
      },
      {
        "kind": "else",
        "label": "[valid token]"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "begin transaction; lock active news",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "check hashed visit ID in news_visits",
        "return": false
      },
      {
        "kind": "message",
        "from": 3,
        "to": 2,
        "label": "return visit existence",
        "return": true
      },
      {
        "kind": "frame",
        "label": "alt [visit already recorded]"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "read unchanged unique_views; commit",
        "return": false
      },
      {
        "kind": "else",
        "label": "[new visit]"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "insert news_visits; check news_viewers",
        "return": false
      },
      {
        "kind": "message",
        "from": 3,
        "to": 2,
        "label": "return viewer existence",
        "return": true
      },
      {
        "kind": "frame",
        "label": "opt [new viewer]"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "insert news_viewers; increment news.unique_views",
        "return": false
      },
      {
        "kind": "end"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "increment news.view; commit",
        "return": false
      },
      {
        "kind": "end"
      },
      {
        "kind": "message",
        "from": 3,
        "to": 2,
        "label": "return unique_views",
        "return": true
      },
      {
        "kind": "message",
        "from": 2,
        "to": 1,
        "label": "JSON: unique_views",
        "return": true
      },
      {
        "kind": "message",
        "from": 1,
        "to": 0,
        "label": "update displayed view count",
        "return": true
      },
      {
        "kind": "end"
      },
      {
        "kind": "note",
        "label": "Repeat submissions of one visit token do not increment counts again. A new visit from a known viewer increases total views, but not unique views."
      }
    ],
    "sources": [
      "app/Http/Controllers/News/EngagementController.php:context/view",
      "resources/js/components/news-engagement.tsx"
    ]
  },
  {
    "slug": "04-record-short-view",
    "title": "Record a short-video view",
    "people": [
      "Viewer\n(Guest / signed-in)",
      "Web Application\n(Short-video player)",
      "ShortViewerController",
      "Application Database"
    ],
    "events": [
      {
        "kind": "message",
        "from": 0,
        "to": 1,
        "label": "open and play a published short video",
        "return": false
      },
      {
        "kind": "message",
        "from": 1,
        "to": 2,
        "label": "GET /shorts/{id}/view-token",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "verify published video and published_at",
        "return": false
      },
      {
        "kind": "message",
        "from": 3,
        "to": 2,
        "label": "return video",
        "return": true
      },
      {
        "kind": "message",
        "from": 2,
        "to": 2,
        "label": "create viewer key and session-bound encrypted token",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 1,
        "label": "return token; set short_visitor cookie",
        "return": true
      },
      {
        "kind": "note",
        "label": "The player tracks qualified visible playback before submitting a view. Server accepts token age 5 seconds to 2 hours."
      },
      {
        "kind": "message",
        "from": 1,
        "to": 2,
        "label": "POST /shorts/{id}/view (token)",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 2,
        "label": "validate video, age, current viewer and session",
        "return": false
      },
      {
        "kind": "frame",
        "label": "alt [invalid token]"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 1,
        "label": "422: reject request",
        "return": true
      },
      {
        "kind": "else",
        "label": "[valid token]"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "begin transaction; lock published short_videos row",
        "return": false
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "insertOrIgnore short_video_viewers(video_id, viewer_key)",
        "return": false
      },
      {
        "kind": "message",
        "from": 3,
        "to": 2,
        "label": "return whether a row was inserted",
        "return": true
      },
      {
        "kind": "frame",
        "label": "opt [first recorded view for this viewer]"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "increment short_videos.view_count",
        "return": false
      },
      {
        "kind": "end"
      },
      {
        "kind": "message",
        "from": 2,
        "to": 3,
        "label": "commit; read view_count",
        "return": false
      },
      {
        "kind": "message",
        "from": 3,
        "to": 2,
        "label": "return view_count",
        "return": true
      },
      {
        "kind": "message",
        "from": 2,
        "to": 1,
        "label": "JSON: view_count",
        "return": true
      },
      {
        "kind": "message",
        "from": 1,
        "to": 0,
        "label": "update displayed count",
        "return": true
      },
      {
        "kind": "end"
      },
      {
        "kind": "note",
        "label": "Short-video view_count is deduplicated by (short_video_id, viewer_key). Unlike news, this flow has no separate news_visits-style total-visit counter."
      }
    ],
    "sources": [
      "app/Http/Controllers/Home/ShortViewerController.php:token/view",
      "resources/js/pages/short-viewer.tsx"
    ]
  },

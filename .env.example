AI_PROVIDER=ollama

# Optional shared secret used by Laravel for internal FastAPI calls. Leave blank
# during local development, but configure the same strong value in both services
# before cloud deployment.
INTERNAL_API_TOKEN=
API_VERSION=v1

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# RAG embeddings. Use embedding_gemma to remove the Ollama embedding dependency.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=google/embeddinggemma-300m
EMBEDDING_DEVICE=auto
EMBEDDING_DIMENSIONS=768
EMBEDDING_INDEX_VERSION=v1

# Optional local Gemma 4 generation provider. Model files are downloaded to the
# Hugging Face cache and must not be committed to this repository.
GEMMA_MODEL=google/gemma-4-E4B-it
GEMMA_DEVICE=auto
GEMMA_MAX_NEW_TOKENS=2048
GEMMA_TOP_P=0.95
GEMMA_TOP_K=64

# Cloud GPU generation through a self-hosted vLLM OpenAI-compatible server.
# From the host use http://localhost:8002/v1. Between Compose services use
# http://vllm:8000/v1.
VLLM_BASE_URL=http://localhost:8002/v1
VLLM_API_KEY=
VLLM_MODEL=google/gemma-4-E2B-it
VLLM_TIMEOUT_SECONDS=180
VLLM_MAX_TOKENS=2048

# Local Apple Silicon/CPU generation through llama.cpp's llama-server.
LLAMA_CPP_BASE_URL=http://localhost:8080/v1
LLAMA_CPP_API_KEY=
LLAMA_CPP_MODEL=apakhabar-gemma
LLAMA_CPP_TIMEOUT_SECONDS=180
LLAMA_CPP_MAX_TOKENS=4096

CHROMA_PATH=./data/chroma

MAX_UPLOAD_MB=20
OCR_LANGUAGES=ind+eng
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75
RAG_SEMANTIC_WEIGHT=0.7
RAG_KEYWORD_WEIGHT=0.3
RAG_CANDIDATE_MULTIPLIER=4

# Optional real-time grounding. Without a key, factual requests fall back to
# approved documents and structured clarification instead of inventing facts.
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=15

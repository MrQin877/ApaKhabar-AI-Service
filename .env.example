OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

CHROMA_PATH=./data/chroma

MAX_UPLOAD_MB=20
OCR_LANGUAGES=ind+eng
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75

# Optional real-time grounding. Without a key, factual requests fall back to
# approved documents and structured clarification instead of inventing facts.
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=15

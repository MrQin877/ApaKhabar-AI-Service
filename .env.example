# Generation: existing local llama.cpp OpenAI-compatible server
AI_PROVIDER=llama_cpp
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_MODEL=apakhabar-gemma
LLAMA_CPP_API_KEY=
LLAMA_CPP_TIMEOUT_SECONDS=180
LLAMA_CPP_MAX_TOKENS=4096

# EmbeddingGemma requires requirements-embedding.txt and a cached model.
EMBEDDING_PROVIDER=embedding_gemma
EMBEDDING_MODEL=google/embeddinggemma-300m
EMBEDDING_DEVICE=auto
EMBEDDING_DIMENSIONS=768
# Alternative embedding server (EMBEDDING_PROVIDER=openai)
EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
EMBEDDING_API_KEY=

# Optional Ollama provider, including legacy paths
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Match Laravel's service token. All API traffic must come from trusted Laravel.
APAKHABAR_AI_SERVICE_TOKEN=
AGENT_ENABLED=true
AGENT_DB_PATH=./data/agent/checkpoints.sqlite
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_REVISIONS=2
AGENT_MAX_SECONDS=900
AGENT_QUALITY_TARGET=80

# Optional HTTP web-search adapter. Results always require source approval.
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=

CHROMA_PATH=./data/chroma
UPLOAD_PATH=./data/uploads
MAX_UPLOAD_MB=20
OCR_LANGUAGE=eng
OCR_MAX_PAGES=100
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75

# ApaKhabar AI Service example. Never put real credentials in this tracked file.
# Required for unified Docker: Gemini writer, independent OpenAI judge,
# OpenAI embeddings, and a service token shared with Laravel.
# Repo A Compose overrides provider URLs, model IDs, and storage paths for Docker.

# Legacy selector retained from the previous .env; current code ignores it.
AI_PROVIDER=llama_cpp

# Legacy llama.cpp settings. Current code does not read these variables.
LLAMA_CPP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLAMA_CPP_API_KEY=
LLAMA_CPP_MODEL=gemini-3.8-flash
LLAMA_CPP_TIMEOUT_SECONDS=180
LLAMA_CPP_MAX_TOKENS=4096

# Required Gemini writer settings used by current code.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=180
AI_MAX_TOKENS=4096

# Legacy Ollama settings. No active inference path uses Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Gemini API embeddings. Alternatives: embedding_gemma (local) or openai.
# Provider, model, and dimension form the Chroma collection fingerprint.
# Reindex approved information after changing providers; keep old collections.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DEVICE=auto
EMBEDDING_DIMENSIONS=768
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=

# Agent workflow and checkpoints.
AGENT_ENABLED=true
AGENT_DB_PATH=./data/agent/checkpoints.sqlite
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_REVISIONS=2
AGENT_MAX_SECONDS=900
AGENT_QUALITY_TARGET=80
# Optional; defaults to the repository's skills directory.
AGENT_SKILLS_PATH=./skills

# Persistent storage and document processing.
CHROMA_PATH=./data/chroma
UPLOAD_PATH=./data/uploads
MAX_UPLOAD_MB=20
OCR_LANGUAGE=ind+eng
OCR_MAX_PAGES=100
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75

# Required in a shared deployment; use the same nonempty token in Laravel.
APAKHABAR_AI_SERVICE_TOKEN=

# Optional web search adapter.
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=

# Optional LangSmith tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ApaKhabar-Agent

# Required independent OpenAI judge for the unified workflow.
EVALUATOR_ENABLED=true
# Legacy provider selector; current code ignores it.
EVALUATOR_PROVIDER=llama_cpp
EVALUATOR_BASE_URL=https://api.openai.com/v1
EVALUATOR_API_KEY=
EVALUATOR_MODEL=gpt-4.1-mini
EVALUATOR_TIMEOUT_SECONDS=180
EVALUATOR_MAX_TOKENS=4096

# ==========================================
# ApaKhabar AI Service Configuration
# ==========================================

# 1. Generation Provider (LLM)
# Options: llama_cpp, ollama
AI_PROVIDER=llama_cpp

# 1A. llama.cpp Settings
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_API_KEY=
LLAMA_CPP_MODEL=apakhabar-gemma
LLAMA_CPP_TIMEOUT_SECONDS=180
LLAMA_CPP_MAX_TOKENS=4096

# 1B. Ollama Settings (Alternative)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# 2. Embedding Provider (RAG)
# Options: embedding_gemma, ollama, openai
EMBEDDING_PROVIDER=embedding_gemma
EMBEDDING_MODEL=google/embeddinggemma-300m
EMBEDDING_DEVICE=auto
EMBEDDING_DIMENSIONS=768

# 2A. External Embedding API (If EMBEDDING_PROVIDER=openai)
EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
EMBEDDING_API_KEY=

# 3. LangGraph Agent Configuration
AGENT_ENABLED=true
AGENT_DB_PATH=./data/agent/checkpoints.sqlite
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_REVISIONS=2
AGENT_MAX_SECONDS=900
AGENT_QUALITY_TARGET=80

# 4. Storage & Processing
CHROMA_PATH=./data/chroma
UPLOAD_PATH=./data/uploads
MAX_UPLOAD_MB=20

# 5. Document Extraction (OCR & RAG)
OCR_LANGUAGE=ind+eng
OCR_MAX_PAGES=100
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.75

# 6. Separate Judge Model
# Start: python scripts/start_judge.py
EVALUATOR_ENABLED=true
EVALUATOR_PROVIDER=llama_cpp
EVALUATOR_BASE_URL=http://127.0.0.1:8082/v1
EVALUATOR_MODEL=apakhabar-judge
EVALUATOR_TIMEOUT_SECONDS=180
EVALUATOR_MAX_TOKENS=4096

# 7. Security (Laravel Integration)
# Must match Laravel's APAKHABAR_AI_SERVICE_TOKEN.
APAKHABAR_AI_SERVICE_TOKEN=

# 8. Optional Web Search Adapter
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=

# 9. Observability (LangSmith Tracing - Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ApaKhabar-Agent